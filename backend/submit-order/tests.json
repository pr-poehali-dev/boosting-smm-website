{
  "tests": [
    {
      "name": "Submit boost order successfully",
      "method": "POST",
      "body": {
        "service_type": "boost",
        "link": "https://t.me/test/123",
        "quantity": 1000
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "order": {
          "service_type": "boost",
          "link": "https://t.me/test/123",
          "quantity": 1000,
          "status": "processing"
        }
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject empty fields",
      "method": "POST",
      "body": {
        "service_type": "",
        "link": "",
        "quantity": 0
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "Missing required fields"
      },
      "bodyMatcher": "partial"
    }
  ]
}
